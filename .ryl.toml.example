ignore = """
vendor/**
generated/**
"""
locale = "en_US.UTF-8"

[files]
yaml = ["*.yaml", "*.yml", ".yamllint"]
markdown = ["*.md", "*.markdown"]

[markdown]
front-matter = true
fenced-blocks = true

[lint.per-file-ignores]
"**/values.yaml" = ["document-start"]
"**/kustomization.yaml" = ["document-start"]

[lint]
fixable = ["ALL"]
unfixable = ["comments"]

[lint.rules.anchors]
level = "warning"
forbid-undeclared-aliases = true
forbid-duplicated-anchors = true
forbid-unused-anchors = false

[lint.rules.block-scalar-chomping]
level = "warning"

[lint.rules.braces]
level = "warning"
forbid = "non-empty"
min-spaces-inside = 0
max-spaces-inside = 1
min-spaces-inside-empty = 0
max-spaces-inside-empty = 0

[lint.rules.brackets]
level = "warning"
forbid = false
min-spaces-inside = 0
max-spaces-inside = 0
min-spaces-inside-empty = 0
max-spaces-inside-empty = 0

[lint.rules.colons]
level = "warning"
max-spaces-before = 0
max-spaces-after = 1

[lint.rules.commas]
level = "warning"
max-spaces-before = 0
min-spaces-after = 1
max-spaces-after = 1

[lint.rules.comments]
level = "warning"
require-starting-space = true
ignore-shebangs = true
min-spaces-from-content = 1
max-spaces-from-content = -1
ignore = ["generated.yaml"]

[lint.rules.comments-indentation]
level = "warning"
allow-any-open-indent = false

[lint.rules.document-end]
level = "warning"
present = false

[lint.rules.document-start]
level = "warning"
present = true

[lint.rules.empty-lines]
level = "warning"
max = 1
max-start = 0
max-end = 0

[lint.rules.empty-values]
level = "warning"
forbid-in-block-mappings = false
forbid-in-flow-mappings = true
forbid-in-block-sequences = false

[lint.rules.float-values]
level = "warning"
require-numeral-before-decimal = true
forbid-scientific-notation = false
forbid-nan = true
forbid-inf = true

[lint.rules.hyphens]
level = "warning"
max-spaces-after = 1
dash-on-own-line = false

[lint.rules.indentation]
level = "warning"
spaces = 2
indent-sequences = "consistent"
check-multi-line-strings = false

[lint.rules.key-duplicates]
level = "warning"
forbid-duplicated-merge-keys = true
check-canonical = false
forbid-merge-key-shadowing = false

[lint.rules.key-ordering]
level = "warning"
ignored-keys = ["^x-", "^X-"]

[lint.rules.line-length]
level = "warning"
max = 100
allow-non-breakable-words = true
allow-non-breakable-inline-mappings = true

[lint.rules.merge-keys]
level = "warning"

[lint.rules.new-line-at-end-of-file]
level = "warning"

[lint.rules.new-lines]
level = "warning"
type = "unix"

[lint.rules.octal-values]
level = "warning"
forbid-implicit-octal = true
forbid-explicit-octal = true

[lint.rules.quoted-strings]
level = "warning"
quote-type = "double"
required = "only-when-needed"
extra-required = ["^cmd$"]
allow-quoted-quotes = true
allow-double-quotes-for-escaping = false
check-keys = true

[lint.rules.tags]
level = "warning"
forbid-unsafe-tags = true
forbid-removed-types = true
allowed-tags = ["!env", "!include"]

[lint.rules.trailing-spaces]
level = "warning"

[lint.rules.truthy]
level = "warning"
allowed-values = ["true", "false", "yes", "no"]
check-keys = false

[lint.rules.unicode-line-breaks]
level = "warning"
